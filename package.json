{
  "name": "bn-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src tests/unit && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "scan:artifacts": "node scripts/scan-artifacts.mjs",
    "format": "prettier --write src tests scripts *.ts *.json"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "lucide-react": "^0.468.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.4",
    "react-select": "^5.8.0",
    "react-tag-input-component": "^2.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@playwright/test": "^1.64.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^18.0.27",
    "@types/react-dom": "^18.0.10",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "jsdom": "^29.1.1",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": "24.x"
  }
}
