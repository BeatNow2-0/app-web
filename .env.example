# Public configuration; never put secrets in VITE_*.
# Empty = same-origin API behind reverse proxy (recommended).
VITE_API_URL=
# Comma-separated HTTPS origins for avatar/CDN images, if external.
VITE_MEDIA_ORIGINS=
# Development only: proxy /v1/api and /api/v1 to your local backend.
DEV_API_PROXY=
